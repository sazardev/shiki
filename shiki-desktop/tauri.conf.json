{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shiki",
  "identifier": "com.sazardev.shiki",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "shiki — personal notes, private log",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sazardev/shiki/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2NDMwNzE0RDAxMDQzMTMKUldRVFF4RFFGQWREMWhlTkhpaXpYUC9HTkNkN2xCcEZOd1AvT1lpbVFWbjBDS3BoSkpnQ1ZmK1QK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
