{
  "manifest_version": 3,
  "name": "Shiki Capture",
  "version": "0.1.0",
  "description": "Quick capture to Shiki notebooks — save selection, page, or quick note instantly. Talks to your local Shiki via native host.",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "nativeMessaging", "notifications"],
  "optional_permissions": ["downloads"],
  "host_permissions": [],
  "action": {
    "default_title": "Shiki Capture",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "incognito": "spanning",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open Shiki quick capture"
    },
    "quick-capture-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Capture selection to Shiki instantly"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["chrome://*/*", "chrome-extension://*/*", "about:*", "data:*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "omnibox": {
    "keyword": "shiki"
  }
}
